# ==============================================================================
# AquaGuard - Git Ignore Configuration
# Protects sensitive data, secrets, build artifacts, and local environments
# ==============================================================================

# --- Environment Variables & Sensitive Credentials (CRITICAL) ---
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# Secrets, Keys, and Service Accounts
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets.json
serviceAccountKey*.json
firebase-adminsdk*.json

# --- Dependencies & Packages ---
node_modules/
.pnp
.pnp.js

# --- Build Artifacts & Distribution ---
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# --- Cache Directories ---
.vite/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# --- Logs & Debug Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor & OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Workspace configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Temporary Files ---
tmp/
temp/
*.tmp
